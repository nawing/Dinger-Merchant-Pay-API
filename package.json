{
  "name": "@mmpay/dinger",
  "version": "2.1.8",
  "description": "Unofficial Dinger Package by MMPay",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "Dinger",
    "KBZPay",
    "AYAPay",
    "UAB",
    "Visa",
    "Master"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "Naw Ing",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nawing/Dinger-Merchant-Pay-API.git"
  },
  "bugs": {
    "url": "https://github.com/nawing/Dinger-Merchant-Pay-API/issues"
  },
  "homepage": "https://github.com/nawing/Dinger-Merchant-Pay-API#readme",
  "scripts": {
    "clean": "rm -rf dist",
    "check": "tsc --noEmit",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build": "bun run clean && bun run check && bun run build:esm && bun run build:cjs",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "chai": "^4.3.4",
    "dotenv": "^17.2.2",
    "typescript": "^7.0.2"
  }
}
